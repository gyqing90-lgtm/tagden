# ---------- 本机配置与账号（含明文密钥，绝对不要上传） ----------
data/
data-tagden/
# 内嵌默认账号的密文：配合 lib/secure.js 的主密钥可解出真实账号，不进版本库
lib/seed.js
oss.config.json
.cache/
.probe/
.workbuddy/

# ---------- 第三方运行库（随交接包线下传递，不进仓库；来源见 交接说明.md） ----------
vendor/llama/*.zip

# ---------- 构建产物（体积大，走 OSS 分发，不进仓库） ----------
node_modules/
.build-tools/
dist/
dist-mac/
# release-mac/ 里的 start.command 与 使用说明.txt 是 build-mac.js 的构建模板，
# 必须进仓库（2026-11-09 的交接包就因为整目录被忽略而丢了这两个文件）；
# 目录里其余临时文件仍忽略。
release-mac/*
!release-mac/start.command
!release-mac/使用说明.txt
*.exe
*.zip
*.7z

# ---------- 编辑器 / 系统 ----------
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
.idea/
.vscode/

# ---------- 本地测试素材（不进仓库） ----------
_jobtest/
screenshots/

# ---------- 更新清单签名私钥（公钥 update-pubkey.pem 要进仓库） ----------
update-signing-key.pem
*-signing-key.pem

# ---------- 站点 canary 本地报告 ----------
canary-report*.json
